rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /careerApplications/{applicationId} {
      function isOwner() {
        return request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }

      function isValidCreate() {
        let data = request.resource.data;
        return request.auth != null
          && data.ownerUid == request.auth.uid
          && data.applicationId == applicationId
          && data.status == 'submitted'
          && data.keys().hasAll([
            'applicationId',
            'ownerUid',
            'jobId',
            'name',
            'email',
            'phone',
            'position',
            'portfolio',
            'message',
            'resumeUrl',
            'attachments',
            'status',
            'timestamp'
          ])
          && data.keys().hasOnly([
            'applicationId',
            'ownerUid',
            'jobId',
            'name',
            'email',
            'phone',
            'position',
            'portfolio',
            'message',
            'resumeUrl',
            'attachments',
            'status',
            'timestamp'
          ])
          && data.attachments is list
          && data.attachments.size() <= 4;
      }

      allow create: if isValidCreate();
      allow get: if isOwner();
      allow list: if false;
      allow update: if false;
      allow delete: if isOwner();
    }
  }
}
